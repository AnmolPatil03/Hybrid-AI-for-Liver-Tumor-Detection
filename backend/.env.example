# Copy to .env and fill in. .env is gitignored.

# Gemini API key used to write the final report text (https://aistudio.google.com/apikey).
# Optional: without it the report is built from the standard template.
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional (Windows): full path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
